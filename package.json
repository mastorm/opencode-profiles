    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "@opentui/core": { "optional": false },
    "@opentui/solid": { "optional": false },
    "solid-js": { "optional": false }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@opencode/theme": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
