{
  "name": "opencode-session-profiles",
  "version": "0.1.3",
  "description": "Per-session model profiles for the OpenCode V2 TUI",
  "license": "MIT",
  "author": "mastorm",
  "repository": { "type": "git", "url": "git+https://github.com/mastorm/opencode-profiles.git" },
  "homepage": "https://github.com/mastorm/opencode-profiles#readme",
  "bugs": { "url": "https://github.com/mastorm/opencode-profiles/issues" },
  "keywords": ["opencode", "opencode-plugin", "profiles", "tui", "models"],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
  },
  "files": ["index.ts", "tui.tsx", "config.ts", "rpc.ts", "display.ts", "tsconfig.json", "README.md", "LICENSE"],
  "scripts": {
    "test": "tsx --test *.test.ts",
